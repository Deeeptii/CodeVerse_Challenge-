#include <stdio.h>
#include <stdlib.h>
#include <string.h>

// Function to check if parentheses are valid
int isValid(char* s) {
    // Figure out the length of the string
    int length = strlen(s);
    
    // We'll use an array as a stack
    // The stack can't be bigger than the string length
    char stack[10000];  // Assuming max length is 10^4 as per constraints
    int top = -1;  // Stack pointer starts at -1 (empty stack)
    
    // Loop through each character in the string
    for (int i = 0; i < length; i++) {
        char current = s[i];
        
        // If it's an opening bracket, add it to the stack
        if (current == '(' || current == '{' || current == '[') {
            top++;  // Move stack pointer
            stack[top] = current;  // Add to stack
        }
        // If it's a closing bracket
        else {
            // If stack is empty, there's no matching opening bracket
            if (top == -1) {
                return 0;  // Invalid
            }
            
            // Check if the closing bracket matches the last opening bracket
            if ((current == ')' && stack[top] != '(') ||
                (current == '}' && stack[top] != '{') ||
                (current == ']' && stack[top] != '[')) {
                return 0;  // Invalid
            }
            
            // If it matches, remove the opening bracket from stack
            top--;
        }
    }
    
    // If stack is empty, all brackets were matched
    if (top == -1) {
        return 1;  // Valid
    } else {
        return 0;  // Invalid - some opening brackets weren't closed
    }
}

// Main function to test the code
int main() {
    // Test examples
    printf("Example 1: %s\n", isValid("()") ? "true" : "false");
    printf("Example 2: %s\n", isValid("()[]{}") ? "true" : "false");
    printf("Example 3: %s\n", isValid("(]") ? "true" : "false");
    printf("Example 4: %s\n", isValid("([])") ? "true" : "false");
    
    return 0;
}
