#include <stdio.h>
#include <stdlib.h>
#include <string.h>

int evalRPN(char** tokens, int tokensSize) {
    // Create a stack to store operands
    int* stack = (int*)malloc(tokensSize * sizeof(int));
    int top = -1; // Stack pointer
    
    // Process each token
    for (int i = 0; i < tokensSize; i++) {
        // Check if the token is an operator
        if (strcmp(tokens[i], "+") == 0 || 
            strcmp(tokens[i], "-") == 0 || 
            strcmp(tokens[i], "*") == 0 || 
            strcmp(tokens[i], "/") == 0) {
            
            // Pop the top two operands
            int b = stack[top--];
            int a = stack[top--];
            int result = 0;
            
            // Perform the operation
            if (strcmp(tokens[i], "+") == 0) {
                result = a + b;
            } else if (strcmp(tokens[i], "-") == 0) {
                result = a - b;
            } else if (strcmp(tokens[i], "*") == 0) {
                result = a * b;
            } else if (strcmp(tokens[i], "/") == 0) {
                result = a / b;
            }
            
            // Push the result onto the stack
            stack[++top] = result;
        } 
        // If it's an operand, push it onto the stack
        else {
            stack[++top] = atoi(tokens[i]);
        }
    }
    
    // The final result should be the only item left on the stack
    int result = stack[top];
    free(stack);
    return result;
}

// Test function
int main() {
    // Test case 1: ["2", "1", "+", "3", "*"] = 9
    char* test1[] = {"2", "1", "+", "3", "*"};
    printf("Test 1: %d\n", evalRPN(test1, 5));  // Should output 9
    
    // Test case 2: ["4", "13", "5", "/", "+"] = 6
    char* test2[] = {"4", "13", "5", "/", "+"};
    printf("Test 2: %d\n", evalRPN(test2, 5));  // Should output 6
    
    // Test case 3: ["10", "6", "9", "3", "+", "-11", "*", "/", "*", "17", "+", "5", "+"] = 22
    char* test3[] = {"10", "6", "9", "3", "+", "-11", "*", "/", "*", "17", "+", "5", "+"};
    printf("Test 3: %d\n", evalRPN(test3, 13));  // Should output 22
    
    return 0;
}
