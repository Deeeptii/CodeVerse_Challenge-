#include <stdio.h>
#include <stdlib.h>

int trap(int* height, int heightSize) {
    // Edge case: if array is empty or has only one element
    if (heightSize <= 2) {
        return 0;
    }
    
    int totalWater = 0;
    
    // Create arrays to store the maximum height to the left and right of each position
    int* leftMax = (int*)malloc(heightSize * sizeof(int));
    int* rightMax = (int*)malloc(heightSize * sizeof(int));
    
    // Initialize the leftMax array
    leftMax[0] = height[0];
    for (int i = 1; i < heightSize; i++) {
        leftMax[i] = (height[i] > leftMax[i-1]) ? height[i] : leftMax[i-1];
    }
    
    // Initialize the rightMax array
    rightMax[heightSize-1] = height[heightSize-1];
    for (int i = heightSize-2; i >= 0; i--) {
        rightMax[i] = (height[i] > rightMax[i+1]) ? height[i] : rightMax[i+1];
    }
    
    // Calculate water trapped at each position
    for (int i = 1; i < heightSize-1; i++) {
        // The water trapped at position i is the minimum of the maximum
        // heights to its left and right, minus the height at position i
        int waterAtPosition = (leftMax[i] < rightMax[i]) ? leftMax[i] : rightMax[i];
        waterAtPosition -= height[i];
        
        // If waterAtPosition is positive, add it to the total
        if (waterAtPosition > 0) {
            totalWater += waterAtPosition;
        }
    }
    
    // Free the allocated memory
    free(leftMax);
    free(rightMax);
    
    return totalWater;
}

// Test function
int main() {
    // Test case 1: [0,1,0,2,1,0,1,3,2,1,2,1] -> 6
    int test1[] = {0, 1, 0, 2, 1, 0, 1, 3, 2, 1, 2, 1};
    printf("Test 1: %d\n", trap(test1, 12));  // Should output 6
    
    // Test case 2: [4,2,0,3,2,5] -> 9
    int test2[] = {4, 2, 0, 3, 2, 5};
    printf("Test 2: %d\n", trap(test2, 6));  // Should output 9
    
    return 0;
}
